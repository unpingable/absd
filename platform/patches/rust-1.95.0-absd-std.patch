diff --git a/library/std/src/sys/env/absd.rs b/library/std/src/sys/env/absd.rs
new file mode 100644
index 0000000..16614dd
--- /dev/null
+++ b/library/std/src/sys/env/absd.rs
@@ -0,0 +1,48 @@
+//! ABSD: a read-only environment. A program's variables come only from
+//! init's policy, carried in its startup record; nothing is inherited, and
+//! a running program cannot change them.
+
+pub use super::common::Env;
+use crate::ffi::{OsStr, OsString};
+use crate::io;
+
+unsafe extern "C" {
+    fn __absd_std_environ(count: *mut usize) -> *const [usize; 2];
+}
+
+/// `(key, value)` byte pairs; the runtime validated every entry (a
+/// non-empty unique key before the first `=`, no NUL) and never frees them.
+fn entries() -> impl Iterator<Item = (&'static [u8], &'static [u8])> {
+    let mut count = 0usize;
+    let table = unsafe { __absd_std_environ(&mut count) };
+    let table: &'static [[usize; 2]] =
+        if table.is_null() { &[] } else { unsafe { crate::slice::from_raw_parts(table, count) } };
+    table.iter().map(|&[pointer, length]| {
+        let entry: &'static [u8] =
+            unsafe { crate::slice::from_raw_parts(pointer as *const u8, length) };
+        let at = entry.iter().position(|&byte| byte == b'=').unwrap_or(entry.len());
+        (&entry[..at], entry.get(at + 1..).unwrap_or(&[]))
+    })
+}
+
+fn os(bytes: &[u8]) -> OsString {
+    // SAFETY: ABSD's `OsStr` is bytes; any byte sequence is valid.
+    unsafe { OsString::from_encoded_bytes_unchecked(bytes.to_vec()) }
+}
+
+pub fn env() -> Env {
+    Env::new(entries().map(|(key, value)| (os(key), os(value))).collect())
+}
+
+pub fn getenv(key: &OsStr) -> Option<OsString> {
+    let key = key.as_encoded_bytes();
+    entries().find(|(name, _)| *name == key).map(|(_, value)| os(value))
+}
+
+pub unsafe fn setenv(_: &OsStr, _: &OsStr) -> io::Result<()> {
+    Err(io::const_error!(io::ErrorKind::Unsupported, "ABSD's environment is read-only"))
+}
+
+pub unsafe fn unsetenv(_: &OsStr) -> io::Result<()> {
+    Err(io::const_error!(io::ErrorKind::Unsupported, "ABSD's environment is read-only"))
+}
