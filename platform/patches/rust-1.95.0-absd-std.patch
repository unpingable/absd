diff --git a/library/std/src/os/absd/fs.rs b/library/std/src/os/absd/fs.rs
new file mode 100644
index 0000000..1c58e73
--- /dev/null
+++ b/library/std/src/os/absd/fs.rs
@@ -0,0 +1,52 @@
+//! ABSD filesystem identity and the one rename variant the platform adds.
+
+#![unstable(feature = "absd_fs_ext", issue = "none")]
+
+use crate::fs;
+use crate::io;
+use crate::path::Path;
+use crate::sys::{AsInner, FromInner};
+
+/// ABSD-specific extensions to [`fs::Metadata`].
+pub trait MetadataExt {
+    /// The filesystem instance, chosen at format.
+    fn filesystem_id(&self) -> u64;
+    /// The object's serial: allocated from a persisted counter and never
+    /// reused, so `(filesystem_id, object_serial)` names one object for the
+    /// life of the filesystem.
+    fn object_serial(&self) -> u64;
+    /// 1 while the object has a name, 0 once unlinked but still open.
+    fn links(&self) -> u64;
+}
+
+impl MetadataExt for fs::Metadata {
+    fn filesystem_id(&self) -> u64 {
+        self.as_inner().filesystem_id()
+    }
+    fn object_serial(&self) -> u64 {
+        self.as_inner().object_serial()
+    }
+    fn links(&self) -> u64 {
+        self.as_inner().links()
+    }
+}
+
+/// ABSD-specific extensions to [`fs::Permissions`]. An ABSD object has one
+/// permission: whether it is read-only.
+pub trait PermissionsExt {
+    /// Permissions that are read-only or not.
+    fn from_readonly(readonly: bool) -> Self;
+}
+
+impl PermissionsExt for fs::Permissions {
+    fn from_readonly(readonly: bool) -> Self {
+        fs::Permissions::from_inner(crate::sys::fs::FilePermissions::from_readonly(readonly))
+    }
+}
+
+/// Renames `from` to `to` only when `to` does not exist; otherwise fails
+/// with [`io::ErrorKind::AlreadyExists`]. The existence check and the move
+/// are one durable metadata commit.
+pub fn rename_noreplace<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<()> {
+    crate::sys::fs::rename_noreplace(from.as_ref(), to.as_ref())
+}
