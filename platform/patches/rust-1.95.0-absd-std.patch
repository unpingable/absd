@@ -0,0 +1,35 @@
+pub use super::common::Args;
+
+use crate::ffi::OsString;
+use crate::sync::atomic::{AtomicIsize, AtomicPtr, Ordering};
+
+static ARGC: AtomicIsize = AtomicIsize::new(0);
+static ARGV: AtomicPtr<*const u8> = AtomicPtr::new(crate::ptr::null_mut());
+
+pub unsafe fn init(argc: isize, argv: *const *const u8) {
+    ARGV.store(argv.cast_mut(), Ordering::Relaxed);
+    ARGC.store(argc, Ordering::Release);
+}
+
+pub fn args() -> Args {
+    let argc = ARGC.load(Ordering::Acquire).max(0) as usize;
+    let argv = ARGV.load(Ordering::Relaxed);
+    let mut values = Vec::with_capacity(argc);
+    if argv.is_null() {
+        return Args::new(values);
+    }
+    for index in 0..argc {
+        let pointer = unsafe { *argv.add(index) };
+        if pointer.is_null() {
+            break;
+        }
+        let mut length = 0usize;
+        while unsafe { *pointer.add(length) } != 0 {
+            let Some(next) = length.checked_add(1) else { break };
+            length = next;
+        }
+        let bytes = unsafe { crate::slice::from_raw_parts(pointer, length) };
+        values.push(OsString::from(crate::string::String::from_utf8_lossy(bytes).into_owned()));
+    }
+    Args::new(values)
+}
