diff --git a/library/std/src/sys/stdio/absd.rs b/library/std/src/sys/stdio/absd.rs
new file mode 100644
index 0000000..4356861
--- /dev/null
+++ b/library/std/src/sys/stdio/absd.rs
@@ -0,0 +1,84 @@
+use crate::io::{self, IoSlice, IoSliceMut};
+
+unsafe extern "C" {
+    fn __absd_std_read(bytes: *mut u8, length: usize) -> isize;
+    fn __absd_std_write(bytes: *const u8, length: usize) -> isize;
+    fn __absd_std_stderr_write(bytes: *const u8, length: usize) -> isize;
+}
+
+pub struct Stdin;
+pub struct Stdout;
+pub struct Stderr;
+
+impl Stdin { pub const fn new() -> Self { Self } }
+impl Stdout { pub const fn new() -> Self { Self } }
+impl Stderr { pub const fn new() -> Self { Self } }
+
+fn error(result: isize) -> io::Error {
+    let kind = match result {
+        -1 => io::ErrorKind::PermissionDenied,
+        -2 => io::ErrorKind::NotFound,
+        -11 => io::ErrorKind::WouldBlock,
+        -12 => io::ErrorKind::OutOfMemory,
+        -14 | -22 => io::ErrorKind::InvalidInput,
+        -24 => io::ErrorKind::QuotaExceeded,
+        -32 => io::ErrorKind::BrokenPipe,
+        -38 => io::ErrorKind::Unsupported,
+        -110 => io::ErrorKind::TimedOut,
+        _ => io::ErrorKind::Other,
+    };
+    io::Error::new(kind, "ABSD I/O syscall failed")
+}
+
+impl io::Read for Stdin {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        let result = unsafe { __absd_std_read(buf.as_mut_ptr(), buf.len()) };
+        if result < 0 { Err(error(result)) } else { Ok(result as usize) }
+    }
+
+    fn read_vectored(&mut self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        match bufs.iter_mut().find(|buf| !buf.is_empty()) {
+            Some(buf) => self.read(buf),
+            None => Ok(0),
+        }
+    }
+}
+
+fn write(buf: &[u8]) -> io::Result<usize> {
+    let result = unsafe { __absd_std_write(buf.as_ptr(), buf.len()) };
+    if result < 0 { Err(error(result)) } else { Ok(result as usize) }
+}
+
+/// The startup record's stderr handle when it names one, else the console.
+fn write_stderr(buf: &[u8]) -> io::Result<usize> {
+    let result = unsafe { __absd_std_stderr_write(buf.as_ptr(), buf.len()) };
+    if result < 0 { Err(error(result)) } else { Ok(result as usize) }
+}
+
+impl io::Write for Stdout {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { write(buf) }
+    fn write_vectored(&mut self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        match bufs.iter().find(|buf| !buf.is_empty()) {
+            Some(buf) => write(buf),
+            None => Ok(0),
+        }
+    }
+    fn flush(&mut self) -> io::Result<()> { Ok(()) }
+}
+
+impl io::Write for Stderr {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { write_stderr(buf) }
+    fn write_vectored(&mut self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        match bufs.iter().find(|buf| !buf.is_empty()) {
+            Some(buf) => write_stderr(buf),
+            None => Ok(0),
+        }
+    }
+    fn flush(&mut self) -> io::Result<()> { Ok(()) }
+}
+
+pub const STDIN_BUF_SIZE: usize = 256;
+
+pub fn is_ebadf(_err: &io::Error) -> bool { false }
+
+pub fn panic_output() -> Option<Stderr> { Some(Stderr::new()) }
