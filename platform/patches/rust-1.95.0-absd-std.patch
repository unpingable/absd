+//! ABSD: `std::process` two ways (the kernel's `docs/PROCESS-STARTUP.md`).
+//!
+//! **From a file.** A process that holds the kernel's spawn right and no
+//! broker channel starts programs itself: the runtime reads the file at
+//! the program path (absolute, or relative to the working directory; a bare
+//! name is refused, there is no PATH search) from the mounted filesystem
+//! and starts it with the kernel's `spawn_image`. The child gets argv, the
+//! environment (ours with the `Command`'s changes), the working directory
+//! (ours, or the `Command`'s), its three streams, and a read-only view of
+//! the filesystem. `inherit` passes our own stdin/stdout/stderr handle;
+//! `null` and `piped` are pipes (null output is drained and discarded while
+//! we wait). A pipe end this process holds (`ChildStdout`, `ChildStdin`,
+//! `ChildStderr` converted with `Stdio::from`) may be given as a stream:
+//! the child gets a copy with only the right that stream needs (read for
+//! stdin, write for stdout and stderr; the kernel refuses a right the end
+//! does not carry), and on success the spawn consumes it, closing this
+//! process's copy at once so that end-of-file and broken pipe depend on the
+//! child alone. A `Command` whose handle was consumed refuses to spawn
+//! again (`InvalidInput`). `kill` ends the child through the kernel.
+//!
+//! **Through init's broker** (the kernel's `docs/BROKER.md`), unchanged,
+//! when init started this process as a brokered worker: its runtime holds a
+//! request/reply channel to init and a fixed number of slots, each three
+//! pipes made in advance. `spawn` spends the next unspent slot on one
+//! request naming the program path exactly as given to `Command::new` and
+//! its arguments; init decides against its fixed policy and starts the
+//! child or refuses. There, setting an environment variable or a working
+//! directory, and killing, are `Unsupported`. A refusal spends nothing.
+//! Standard streams on this path:
+//!
+//! * `piped` is the slot's pipe end;
+//! * `null` stdin closes the writer at spawn, so the child reads EOF;
+//! * `null` stdout/stderr keeps the reader and discards whatever arrives
+//!   while this process waits (`wait`, `try_wait`, `output`). The reader is
+//!   not closed at spawn: the child's writes would then fail with a broken
+//!   pipe instead of disappearing;
+//! * `inherit` (and `io::stdout()`/`io::stderr()`) for stdout/stderr copies
+//!   what arrives, while this process waits, to this process's own stream;
+//!   `inherit` stdin is `Unsupported`: the child never shares our input.
+//!
+//! Because nothing runs while this process is not waiting, a child whose
+//! discarded or copied output fills its pipe blocks until the parent waits.
+
+use super::env::{CommandEnv, CommandEnvs};
+pub use crate::ffi::OsString as EnvKey;
+use crate::ffi::{OsStr, OsString};
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut};
+use crate::num::NonZero;
+use crate::path::Path;
+use crate::process::StdioPipes;
+use crate::sys::fs::File;
+use crate::fmt;
+
+unsafe extern "C" {
+    fn __absd_std_process_spawn(
+        path: *const u8,
+        path_length: usize,
+        args: *const [usize; 2],
+        argc: usize,
+        out: *mut [u64; 5],
+    ) -> i64;
+    fn __absd_std_process_wait(slot: u64, nonblocking: u64, value: *mut i64) -> i64;
+    fn __absd_std_process_brokered() -> u64;
+    fn __absd_std_process_spawn_image(request: *const RawSpawn, out: *mut [u64; 5]) -> i64;
+    fn __absd_std_process_kill(token: u64) -> i64;
+    fn __absd_std_handle_read(handle: u64, bytes: *mut u8, length: usize, timeout: u64) -> isize;
+    fn __absd_std_handle_write(handle: u64, bytes: *const u8, length: usize) -> isize;
+    fn __absd_std_handle_close(handle: u64) -> i64;
+    fn __absd_std_write(bytes: *const u8, length: usize) -> isize;
+    fn __absd_std_stderr_write(bytes: *const u8, length: usize) -> isize;
+}
+
+/// Kernel errors and the runtime's broker results (`runtime/src/broker.rs`).
+fn error(code: i64) -> io::Error {
+    use io::ErrorKind::*;
+    let (kind, message) = match code {
+        -2000 => (Unsupported, "process spawning needs init's broker handles"),
+        -2001 => (QuotaExceeded, "every broker slot is spent"),
+        -2002 => (InvalidInput, "empty program path, or a NUL byte in the path or an argument"),
+        -2003 => (ArgumentListTooLong, "spawn request exceeds 4096 bytes or 32 arguments"),
+        -2005 => (InvalidData, "init's broker replies broke the protocol"),
+        -2006 => (BrokenPipe, "init closed the broker channel"),
+        -2010 => (InvalidInput, "ABSD has no PATH search: name the program by its path"),
+        -2011 => (InvalidInput, "environment entries must be KEY=VALUE with a non-empty KEY"),
+        -2012 => (IsADirectory, "the program path is not a regular file"),
+        -2013 => (FileTooLarge, "the program image exceeds 32 MiB"),
+        -2014 => (NotADirectory, "the working directory is not a directory"),
+        -2101 => (PermissionDenied, "init refused the spawn: not permitted"),
+        -2102 => (ResourceBusy, "init refused the spawn: slot unavailable"),
+        -2103 => (InvalidInput, "init refused the spawn: malformed request"),
+        -2104 => (QuotaExceeded, "init refused the spawn: no resources"),
+        code if code <= -2100 => (Other, "init refused the spawn"),
+        -1 => (PermissionDenied, "ABSD I/O syscall failed"),
+        -2 => (NotFound, "ABSD I/O syscall failed"),
+        -8 => (InvalidData, "not a static ELF64 image the ABSD loader accepts"),
+        -9 => (InvalidInput, "ABSD I/O syscall failed: bad handle"),
+        -11 => (WouldBlock, "ABSD I/O syscall failed"),
+        -12 => (OutOfMemory, "ABSD I/O syscall failed"),
+        -14 | -22 => (InvalidInput, "ABSD I/O syscall failed"),
+        -24 => (QuotaExceeded, "ABSD I/O syscall failed"),
+        -32 => (BrokenPipe, "ABSD I/O syscall failed"),
+        -20 => (NotADirectory, "ABSD filesystem: not a directory"),
+        -21 => (IsADirectory, "ABSD filesystem: is a directory"),
+        -38 => (Unsupported, "ABSD I/O syscall failed"),
+        -74 => (InvalidData, "ABSD filesystem: corrupt"),
+        -110 => (TimedOut, "ABSD I/O syscall timed out"),
+        _ => (Other, "ABSD I/O syscall failed"),
+    };
+    io::Error::new(kind, message)
+}
+
+/// What `__absd_std_process_spawn_image` reads (runtime `process.rs`).
+#[repr(C)]
+struct RawSpawn {
+    path: *const u8,
+    path_length: usize,
+    args: *const [usize; 2],
+    argc: usize,
+    env: *const [usize; 2],
+    envc: usize,
+    cwd: *const u8,
+    cwd_length: usize,
+    stdio: [u32; 3],
+    /// For a `STDIO_HANDLE` stream, the pipe end the child gets.
+    handles: [u64; 3],
+}
+
+/// Stream sources for `RawSpawn::stdio`.
+const STDIO_NULL: u32 = 0;
+const STDIO_PIPE: u32 = 1;
+const STDIO_INHERIT: u32 = 2;
+const STDIO_PARENT_STDOUT: u32 = 3;
+const STDIO_PARENT_STDERR: u32 = 4;
+const STDIO_HANDLE: u32 = 5;
+/// Set in a `Process::slot` that is an image child's process handle.
+const IMAGE_CHILD: u64 = 1 << 63;
+
+fn unsupported(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::Unsupported, message)
+}
+
+fn consumed() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidInput,
+        "the pipe end given as this command's stream was consumed by an earlier spawn",
+    )
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Command
+////////////////////////////////////////////////////////////////////////////////
+
+pub struct Command {
+    program: OsString,
+    args: Vec<OsString>,
+    env: CommandEnv,
+
+    cwd: Option<OsString>,
+    stdin: Option<Stdio>,
+    stdout: Option<Stdio>,
+    stderr: Option<Stdio>,
+}
+
+#[derive(Debug)]
+pub enum Stdio {
+    Inherit,
+    Null,
+    MakePipe,
+    ParentStdout,
+    ParentStderr,
+    #[allow(dead_code)] // This variant exists only for the Debug impl
+    InheritFile(File),
+    Handle(ChildPipe),
+    /// A `Handle` an earlier successful spawn consumed.
+    Consumed,
+}
+
+/// What happens to a child's stdout or stderr that the caller does not hold.
+#[derive(Clone, Copy)]
+enum Sink {
+    Discard,
+    Stdout,
+    Stderr,
+}
+
+enum Output {
+    Pipe,
+    Drain(Sink),
+}
+
+fn output_mode(stdio: &Stdio, inherit: Sink) -> io::Result<Output> {
+    match stdio {
+        Stdio::MakePipe => Ok(Output::Pipe),
+        Stdio::Null => Ok(Output::Drain(Sink::Discard)),
+        Stdio::Inherit => Ok(Output::Drain(inherit)),
+        Stdio::ParentStdout => Ok(Output::Drain(Sink::Stdout)),
+        Stdio::ParentStderr => Ok(Output::Drain(Sink::Stderr)),
+        Stdio::InheritFile(_) | Stdio::Handle(_) | Stdio::Consumed => {
+            Err(unsupported("ABSD child output can only be piped, null, or this process's own"))
+        }
+    }
+}
+
+impl Command {
+    pub fn new(program: &OsStr) -> Command {
+        Command {
+            program: program.to_owned(),
+            args: vec![program.to_owned()],
+            env: Default::default(),
+            cwd: None,
+            stdin: None,
+            stdout: None,
+            stderr: None,
+        }
+    }
+
+    pub fn arg(&mut self, arg: &OsStr) {
+        self.args.push(arg.to_owned());
+    }
+
+    pub fn env_mut(&mut self) -> &mut CommandEnv {
+        &mut self.env
+    }
+
+    pub fn cwd(&mut self, dir: &OsStr) {
+        self.cwd = Some(dir.to_owned());
+    }
+
+    pub fn stdin(&mut self, stdin: Stdio) {
+        self.stdin = Some(stdin);
+    }
+
+    pub fn stdout(&mut self, stdout: Stdio) {
+        self.stdout = Some(stdout);
+    }
+
+    pub fn stderr(&mut self, stderr: Stdio) {
+        self.stderr = Some(stderr);
+    }
+
+    pub fn get_program(&self) -> &OsStr {
+        &self.program
+    }
+
+    pub fn get_args(&self) -> CommandArgs<'_> {
+        let mut iter = self.args.iter();
+        iter.next();
+        CommandArgs { iter }
+    }
+
+    pub fn get_envs(&self) -> CommandEnvs<'_> {
+        self.env.iter()
+    }
+
+    pub fn get_env_clear(&self) -> bool {
+        self.env.does_clear()
+    }
+
+    pub fn get_current_dir(&self) -> Option<&Path> {
+        self.cwd.as_ref().map(|cs| Path::new(cs))
+    }
+
+    pub fn spawn(
+        &mut self,
+        default: Stdio,
+        needs_stdin: bool,
+    ) -> io::Result<(Process, StdioPipes)> {
+        if unsafe { __absd_std_process_brokered() } != 0 {
+            self.spawn_brokered(default, needs_stdin)
+        } else {
+            self.spawn_image(default, needs_stdin)
+        }
+    }
+
+    fn spawn_image(
+        &mut self,
+        default: Stdio,
+        needs_stdin: bool,
+    ) -> io::Result<(Process, StdioPipes)> {
+        let null = Stdio::Null;
+        let stdin = self.stdin.as_ref().unwrap_or(if needs_stdin { &default } else { &null });
+        let mut handles = [0u64; 3];
+        let stdin_mode = match stdin {
+            Stdio::MakePipe => STDIO_PIPE,
+            Stdio::Null => STDIO_NULL,
+            Stdio::Inherit => STDIO_INHERIT,
+            Stdio::Handle(pipe) => {
+                handles[0] = pipe.handle;
+                STDIO_HANDLE
+            }
+            Stdio::Consumed => return Err(consumed()),
+            _ => {
+                return Err(unsupported(
+                    "ABSD child stdin can only be piped, null, inherited, or a pipe end",
+                ));
+            }
+        };
+        let output_source = |stdio: &Stdio, slot: &mut u64| match stdio {
+            Stdio::MakePipe => Ok(STDIO_PIPE),
+            Stdio::Null => Ok(STDIO_NULL),
+            Stdio::Inherit => Ok(STDIO_INHERIT),
+            Stdio::ParentStdout => Ok(STDIO_PARENT_STDOUT),
+            Stdio::ParentStderr => Ok(STDIO_PARENT_STDERR),
+            Stdio::Handle(pipe) => {
+                *slot = pipe.handle;
+                Ok(STDIO_HANDLE)
+            }
+            Stdio::Consumed => Err(consumed()),
+            Stdio::InheritFile(_) => Err(unsupported(
+                "ABSD child output can only be piped, null, this process's own, or a pipe end",
+            )),
+        };
+        let stdout_mode =
+            output_source(self.stdout.as_ref().unwrap_or(&default), &mut handles[1])?;
+        let stderr_mode =
+            output_source(self.stderr.as_ref().unwrap_or(&default), &mut handles[2])?;
+
+        let path = self.program.as_encoded_bytes();
+        let args: Vec<[usize; 2]> = self.args[1..]
+            .iter()
+            .map(|arg| {
+                let bytes = arg.as_encoded_bytes();
+                [bytes.as_ptr() as usize, bytes.len()]
+            })
+            .collect();
+        // The child's whole environment: ours with this command's changes.
+        let mut entries: Vec<Vec<u8>> = Vec::new();
+        for (key, value) in self.env.capture() {
+            let key = key.as_encoded_bytes();
+            if key.is_empty() || key.contains(&b'=') {
+                return Err(error(-2011));
+            }
+            let mut entry = key.to_vec();
+            entry.push(b'=');
+            entry.extend_from_slice(value.as_encoded_bytes());
+            entries.push(entry);
+        }
+        let env: Vec<[usize; 2]> =
+            entries.iter().map(|entry| [entry.as_ptr() as usize, entry.len()]).collect();
+        let cwd = self.cwd.as_ref().map_or(&[][..], |cwd| cwd.as_encoded_bytes());
+        let request = RawSpawn {
+            path: path.as_ptr(),
+            path_length: path.len(),
+            args: args.as_ptr(),
+            argc: args.len(),
+            env: env.as_ptr(),
+            envc: env.len(),
+            cwd: cwd.as_ptr(),
+            cwd_length: cwd.len(),
+            stdio: [stdin_mode, stdout_mode, stderr_mode],
+            handles,
+        };
+        let mut out = [0u64; 5];
+        let result = unsafe { __absd_std_process_spawn_image(&request, &mut out) };
+        if result < 0 {
+            // A refused spawn consumes nothing: the pipe ends stay ours.
+            return Err(error(result));
+        }
+        // The child holds its own copies of any pipe ends we gave it; ours
+        // close now (dropping each `ChildPipe`), not when the `Command` is
+        // dropped, so a reader sees EOF and a writer a broken pipe exactly
+        // when the children that hold the other end are done.
+        for slot in [&mut self.stdin, &mut self.stdout, &mut self.stderr] {
+            if matches!(slot, Some(Stdio::Handle(_))) {
+                *slot = Some(Stdio::Consumed);
+            }
+        }
+        let [token, pid, stdin_handle, stdout_handle, stderr_handle] = out;
+        let mut pipes = StdioPipes { stdin: None, stdout: None, stderr: None };
+        let mut drains = [None, None];
+        if stdin_handle != 0 {
+            pipes.stdin = Some(ChildPipe { handle: stdin_handle });
+        }
+        // A pipe end this process holds but the caller did not ask for is
+        // drained while it waits: discarded for null, else copied.
+        for (index, (handle, mode, inherit)) in
+            [(stdout_handle, stdout_mode, Sink::Stdout), (stderr_handle, stderr_mode, Sink::Stderr)]
+                .into_iter()
+                .enumerate()
+        {
+            if handle == 0 {
+                continue;
+            }
+            let pipe = ChildPipe { handle };
+            match mode {
+                STDIO_PIPE if index == 0 => pipes.stdout = Some(pipe),
+                STDIO_PIPE => pipes.stderr = Some(pipe),
+                STDIO_NULL => drains[index] = Some((pipe, Sink::Discard)),
+                STDIO_PARENT_STDOUT => drains[index] = Some((pipe, Sink::Stdout)),
+                STDIO_PARENT_STDERR => drains[index] = Some((pipe, Sink::Stderr)),
+                _ => drains[index] = Some((pipe, inherit)),
+            }
+        }
+        Ok((Process { slot: token, pid, status: None, drains }, pipes))
+    }
+
+    fn spawn_brokered(
+        &mut self,
+        default: Stdio,
+        needs_stdin: bool,
+    ) -> io::Result<(Process, StdioPipes)> {
+        // Everything refusable is refused before a request spends a slot.
+        // An ABSD process has no environment to inherit, so clearing it or
+        // removing from it is already true; giving a child one is not.
+        if self.env.iter().any(|(_, value)| value.is_some()) {
+            return Err(unsupported("ABSD programs have no environment"));
+        }
+        if self.cwd.is_some() {
+            return Err(unsupported("ABSD programs have no working directory"));
+        }
+        let null = Stdio::Null;
+        let stdin = self.stdin.as_ref().unwrap_or(if needs_stdin { &default } else { &null });
+        let stdin_piped = match stdin {
+            Stdio::MakePipe => true,
+            Stdio::Null => false,
+            Stdio::Consumed => return Err(consumed()),
+            _ => return Err(unsupported("ABSD child stdin can only be piped or null")),
+        };
+        let stdout = output_mode(self.stdout.as_ref().unwrap_or(&default), Sink::Stdout)?;
+        let stderr = output_mode(self.stderr.as_ref().unwrap_or(&default), Sink::Stderr)?;
+
+        let path = self.program.as_encoded_bytes();
+        let args: Vec<[usize; 2]> = self.args[1..]
+            .iter()
+            .map(|arg| {
+                let bytes = arg.as_encoded_bytes();
+                [bytes.as_ptr() as usize, bytes.len()]
+            })
+            .collect();
+        let mut out = [0u64; 5];
+        let result = unsafe {
+            __absd_std_process_spawn(path.as_ptr(), path.len(), args.as_ptr(), args.len(), &mut out)
+        };
+        if result < 0 {
+            return Err(error(result));
+        }
+        let [slot, pid, stdin_handle, stdout_handle, stderr_handle] = out;
+        let (stdin_pipe, stdout_pipe, stderr_pipe) = (
+            ChildPipe { handle: stdin_handle },
+            ChildPipe { handle: stdout_handle },
+            ChildPipe { handle: stderr_handle },
+        );
+        let mut pipes = StdioPipes { stdin: None, stdout: None, stderr: None };
+        let mut drains = [None, None];
+        // Null stdin: dropping the only writer gives the child EOF.
+        if stdin_piped {
+            pipes.stdin = Some(stdin_pipe);
+        } else {
+            drop(stdin_pipe);
+        }
+        match stdout {
+            Output::Pipe => pipes.stdout = Some(stdout_pipe),
+            Output::Drain(sink) => drains[0] = Some((stdout_pipe, sink)),
+        }
+        match stderr {
+            Output::Pipe => pipes.stderr = Some(stderr_pipe),
+            Output::Drain(sink) => drains[1] = Some((stderr_pipe, sink)),
+        }
+        Ok((Process { slot, pid, status: None, drains }, pipes))
+    }
+}
+
+pub fn output(cmd: &mut Command) -> io::Result<(ExitStatus, Vec<u8>, Vec<u8>)> {
+    let (mut process, mut pipes) = cmd.spawn(Stdio::MakePipe, false)?;
+    drop(pipes.stdin.take());
+    let (mut stdout, mut stderr) = (Vec::new(), Vec::new());
+    match (pipes.stdout.take(), pipes.stderr.take()) {
+        (None, None) => {}
+        (Some(out), None) => {
+            out.read_to_end(&mut stdout)?;
+        }
+        (None, Some(err)) => {
+            err.read_to_end(&mut stderr)?;
+        }
+        (Some(out), Some(err)) => read_output(out, &mut stdout, err, &mut stderr)?,
+    }
+    let status = process.wait()?;
+    Ok((status, stdout, stderr))
+}
+
+impl From<ChildPipe> for Stdio {
+    fn from(pipe: ChildPipe) -> Stdio {
+        Stdio::Handle(pipe)
+    }
+}
+
+impl From<crate::sys::pipe::Pipe> for Stdio {
+    fn from(pipe: crate::sys::pipe::Pipe) -> Stdio {
+        pipe.diverge()
+    }
+}
+
+impl From<io::Stdout> for Stdio {
+    fn from(_: io::Stdout) -> Stdio {
+        Stdio::ParentStdout
+    }
+}
+
+impl From<io::Stderr> for Stdio {
+    fn from(_: io::Stderr) -> Stdio {
+        Stdio::ParentStderr
+    }
+}
+
+impl From<File> for Stdio {
+    fn from(file: File) -> Stdio {
+        Stdio::InheritFile(file)
+    }
+}
+
+impl fmt::Debug for Command {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if f.alternate() {
+            let mut debug_command = f.debug_struct("Command");
+            debug_command.field("program", &self.program).field("args", &self.args);
+            if !self.env.is_unchanged() {
+                debug_command.field("env", &self.env);
+            }
+            if self.cwd.is_some() {
+                debug_command.field("cwd", &self.cwd);
+            }
+            if self.stdin.is_some() {
+                debug_command.field("stdin", &self.stdin);
+            }
+            if self.stdout.is_some() {
+                debug_command.field("stdout", &self.stdout);
+            }
+            if self.stderr.is_some() {
+                debug_command.field("stderr", &self.stderr);
+            }
+            debug_command.finish()
+        } else {
+            if self.program != self.args[0] {
+                write!(f, "[{:?}] ", self.program)?;
+            }
+            write!(f, "{:?}", self.args[0])?;
+            for arg in &self.args[1..] {
+                write!(f, " {:?}", arg)?;
+            }
+            Ok(())
+        }
+    }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Exit status
+////////////////////////////////////////////////////////////////////////////////
+
+/// Init's EXITED value: the exit status; a fault is `-1000 - vector`;
+/// killed is `-1`.
+#[derive(PartialEq, Eq, Clone, Copy, Debug, Default)]
+pub struct ExitStatus(i64);
+
+impl ExitStatus {
+    pub fn exit_ok(&self) -> Result<(), ExitStatusError> {
+        match NonZero::new(self.0) {
+            None => Ok(()),
+            Some(value) => Err(ExitStatusError(value)),
+        }
+    }
+
+    /// The exit status when the child exited with a non-negative one;
+    /// `None` when it faulted or was killed (and for negative statuses,
+    /// which the outcome encoding cannot tell apart from those).
+    pub fn code(&self) -> Option<i32> {
+        if (0..=i32::MAX as i64).contains(&self.0) { Some(self.0 as i32) } else { None }
+    }
+}
+
+impl fmt::Display for ExitStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.0 {
+            value if value >= 0 => write!(f, "exit status: {value}"),
+            -1 => write!(f, "killed"),
+            value if value <= -1000 => write!(f, "fault: vector {}", -1000 - value),
+            value => write!(f, "exit value: {value}"),
+        }
+    }
+}
+
+#[derive(PartialEq, Eq, Clone, Copy, Debug)]
+pub struct ExitStatusError(NonZero<i64>);
+
+impl Into<ExitStatus> for ExitStatusError {
+    fn into(self) -> ExitStatus {
+        ExitStatus(self.0.get())
+    }
+}
+
+impl ExitStatusError {
+    pub fn code(self) -> Option<NonZero<i32>> {
+        ExitStatus(self.0.get()).code().and_then(NonZero::new)
+    }
+}
+
+#[derive(PartialEq, Eq, Clone, Copy, Debug)]
+pub struct ExitCode(u8);
+
+impl ExitCode {
+    pub const SUCCESS: ExitCode = ExitCode(0);
+    pub const FAILURE: ExitCode = ExitCode(1);
+
+    pub fn as_i32(&self) -> i32 {
+        self.0 as i32
+    }
+}
+
+impl From<u8> for ExitCode {
+    fn from(code: u8) -> Self {
+        Self(code)
+    }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Process
+////////////////////////////////////////////////////////////////////////////////
+
+pub struct Process {
+    /// A broker slot number, or `IMAGE_CHILD` plus the child's process
+    /// handle (the runtime's `wait` and `kill` tell them apart).
+    slot: u64,
+    pid: u64,
+    status: Option<ExitStatus>,
+    /// Child stdout and stderr the caller does not hold, drained on waits.
+    drains: [Option<(ChildPipe, Sink)>; 2],
+}
+
+fn deliver(sink: Sink, mut bytes: &[u8]) {
+    let write: unsafe extern "C" fn(*const u8, usize) -> isize = match sink {
+        Sink::Discard => return,
+        Sink::Stdout => __absd_std_write,
+        Sink::Stderr => __absd_std_stderr_write,
+    };
+    while !bytes.is_empty() {
+        let written = unsafe { write(bytes.as_ptr(), bytes.len()) };
+        if written <= 0 {
+            return;
+        }
+        bytes = &bytes[written as usize..];
+    }
+}
+
+impl Process {
+    pub fn id(&self) -> u32 {
+        self.pid as u32
+    }
+
+    pub fn kill(&mut self) -> io::Result<()> {
+        if self.slot & IMAGE_CHILD == 0 {
+            return Err(unsupported("ABSD's broker has no kill request"));
+        }
+        if self.status.is_some() {
+            return Ok(());
+        }
+        match unsafe { __absd_std_process_kill(self.slot) } {
+            0 => Ok(()),
+            code => Err(error(code)),
+        }
+    }
+
+    fn open_drains(&self) -> usize {
+        self.drains.iter().filter(|drain| drain.is_some()).count()
+    }
+
+    /// One read from each drained stream, each bounded by `timeout` ticks
+    /// (zero: until data or EOF). A stream is dropped at EOF.
+    fn pump(&mut self, timeout: u64) -> io::Result<()> {
+        let mut bytes = [0u8; 256];
+        for drain in &mut self.drains {
+            let Some((pipe, sink)) = drain else { continue };
+            match pipe.read_timeout(&mut bytes, timeout) {
+                Ok(0) => *drain = None,
+                Ok(count) => deliver(*sink, &bytes[..count]),
+                Err(error) if error.kind() == io::ErrorKind::TimedOut => {}
+                Err(error) => return Err(error),
+            }
+        }
+        Ok(())
+    }
+
+    /// Drains until every drained stream has ended; with two, alternates
+    /// with one-tick bounds so neither can stall the other.
+    fn drain_to_end(&mut self) -> io::Result<()> {
+        loop {
+            match self.open_drains() {
+                0 => return Ok(()),
+                1 => self.pump(0)?,
+                _ => self.pump(1)?,
+            }
+        }
+    }
+
+    pub fn wait(&mut self) -> io::Result<ExitStatus> {
+        if let Some(status) = self.status {
+            return Ok(status);
+        }
+        // The child is the only writer left on a drained stream, so these
+        // end when it exits (or closes them).
+        self.drain_to_end()?;
+        let mut value = 0i64;
+        let result = unsafe { __absd_std_process_wait(self.slot, 0, &mut value) };
+        if result < 0 {
+            return Err(error(result));
+        }
+        let status = ExitStatus(value);
+        self.status = Some(status);
+        Ok(status)
+    }
+
+    pub fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        if let Some(status) = self.status {
+            return Ok(Some(status));
+        }
+        self.pump(1)?;
+        let mut value = 0i64;
+        let result = unsafe { __absd_std_process_wait(self.slot, 1, &mut value) };
+        if result < 0 {
+            return Err(error(result));
+        }
+        if result == 0 {
+            return Ok(None);
+        }
+        // Exited: nothing more can be written, so the rest is finite.
+        self.drain_to_end()?;
+        let status = ExitStatus(value);
+        self.status = Some(status);
+        Ok(Some(status))
+    }
+}
+
+pub struct CommandArgs<'a> {
+    iter: crate::slice::Iter<'a, OsString>,
+}
+
+impl<'a> Iterator for CommandArgs<'a> {
+    type Item = &'a OsStr;
+    fn next(&mut self) -> Option<&'a OsStr> {
+        self.iter.next().map(|os| &**os)
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.iter.size_hint()
+    }
+}
+
+impl<'a> ExactSizeIterator for CommandArgs<'a> {
+    fn len(&self) -> usize {
+        self.iter.len()
+    }
+    fn is_empty(&self) -> bool {
+        self.iter.is_empty()
+    }
+}
+
+impl<'a> fmt::Debug for CommandArgs<'a> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_list().entries(self.iter.clone()).finish()
+    }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Slot pipes
+////////////////////////////////////////////////////////////////////////////////
+
+/// One worker-side end of a slot pipe; closed on drop.
+pub struct ChildPipe {
+    handle: u64,
+}
+
+impl ChildPipe {
+    /// The kernel handle of this pipe end (`std::os::absd::process`).
+    pub fn handle(&self) -> u64 {
+        self.handle
+    }
+
+    fn read_timeout(&self, buf: &mut [u8], timeout: u64) -> io::Result<usize> {
+        let result = unsafe { __absd_std_handle_read(self.handle, buf.as_mut_ptr(), buf.len(), timeout) };
+        if result < 0 { Err(error(result as i64)) } else { Ok(result as usize) }
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.read_timeout(buf, 0)
+    }
+
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_>) -> io::Result<()> {
+        io::default_read_buf(|buf| self.read(buf), cursor)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        io::default_read_vectored(|buf| self.read(buf), bufs)
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_to_end(&self, buf: &mut Vec<u8>) -> io::Result<usize> {
+        let start = buf.len();
+        let mut bytes = [0u8; 256];
+        loop {
+            match self.read(&mut bytes)? {
+                0 => return Ok(buf.len() - start),
+                count => buf.extend_from_slice(&bytes[..count]),
+            }
+        }
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        let result = unsafe { __absd_std_handle_write(self.handle, buf.as_ptr(), buf.len()) };
+        if result < 0 { Err(error(result as i64)) } else { Ok(result as usize) }
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        io::default_write_vectored(|buf| self.write(buf), bufs)
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+}
+
+impl Drop for ChildPipe {
+    fn drop(&mut self) {
+        unsafe { __absd_std_handle_close(self.handle) };
+    }
+}
+
+impl fmt::Debug for ChildPipe {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ChildPipe").field("handle", &self.handle).finish()
+    }
+}
+
+/// Reads a child's stdout and stderr to their ends without letting either
+/// stall the other: while both are open, each read is bounded to one tick.
+pub fn read_output(
+    out: ChildPipe,
+    stdout: &mut Vec<u8>,
+    err: ChildPipe,
+    stderr: &mut Vec<u8>,
+) -> io::Result<()> {
+    let mut streams = [(Some(out), stdout), (Some(err), stderr)];
+    let mut bytes = [0u8; 256];
+    loop {
+        let open = streams.iter().filter(|(pipe, _)| pipe.is_some()).count();
+        if open == 0 {
+            return Ok(());
+        }
+        let timeout = if open == 1 { 0 } else { 1 };
+        for (pipe, sink) in &mut streams {
+            let Some(reader) = pipe else { continue };
+            match reader.read_timeout(&mut bytes, timeout) {
+                Ok(0) => *pipe = None,
+                Ok(count) => sink.extend_from_slice(&bytes[..count]),
+                Err(error) if error.kind() == io::ErrorKind::TimedOut => {}
+                Err(error) => return Err(error),
+            }
+        }
+    }
+}
