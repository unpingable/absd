diff --git a/library/std/src/sys/fs/absd.rs b/library/std/src/sys/fs/absd.rs
new file mode 100644
index 0000000..1d1b998
--- /dev/null
+++ b/library/std/src/sys/fs/absd.rs
@@ -0,0 +1,678 @@
+//! ABSD: `std::fs` forwarded to the process's storage runtime.
+//!
+//! The runtime owns the block device and whatever it holds: either the
+//! mounted ABSD filesystem (absolute `/`-rooted paths, files, directories,
+//! read-only flag, rename and no-clobber rename, advisory locks) or, when
+//! nothing is mounted, the one-name `ledger` append region. This file only
+//! translates between `std` types and the runtime's hooks; every semantic
+//! lives behind them. There are no symlinks, hard links, owners, modes,
+//! access/creation timestamps, or file descriptors. Modification time is
+//! whole UTC Unix seconds when known; zero stays Unsupported.
+
+use crate::sync::atomic::{AtomicU64, Ordering};
+use crate::ffi::OsString;
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::hash::{Hash, Hasher};
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::path::{Path, PathBuf};
+pub use crate::sys::fs::common::Dir;
+use crate::sys::time::{SystemTime, UNIX_EPOCH};
+use crate::time::Duration;
+use crate::sys::unsupported;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+struct RawAttr {
+    kind: u32,
+    readonly: u32,
+    size: u64,
+    filesystem: u64,
+    serial: u64,
+    links: u64,
+    mtime: u64,
+}
+
+unsafe extern "C" {
+    fn __absd_std_fs_open(path: *const u8, length: usize, flags: u32) -> i64;
+    fn __absd_std_fs_close(handle: u64) -> i64;
+    fn __absd_std_fs_read_at(handle: u64, offset: u64, bytes: *mut u8, length: usize) -> isize;
+    fn __absd_std_fs_write_at(handle: u64, offset: u64, bytes: *const u8, length: usize) -> isize;
+    fn __absd_std_fs_set_len(handle: u64, length: u64) -> i64;
+    fn __absd_std_fs_sync(handle: u64) -> i64;
+    fn __absd_std_fs_fstat_v2(handle: u64, attr: *mut RawAttr) -> i64;
+    fn __absd_std_fs_stat_v2(path: *const u8, length: usize, attr: *mut RawAttr) -> i64;
+    fn __absd_std_fs_set_readonly(handle: u64, readonly: u32) -> i64;
+    fn __absd_std_fs_set_readonly_path(path: *const u8, length: usize, readonly: u32) -> i64;
+    fn __absd_std_fs_mkdir(path: *const u8, length: usize) -> i64;
+    fn __absd_std_fs_rmdir(path: *const u8, length: usize) -> i64;
+    fn __absd_std_fs_unlink(path: *const u8, length: usize) -> i64;
+    fn __absd_std_fs_rename(
+        from: *const u8,
+        from_length: usize,
+        to: *const u8,
+        to_length: usize,
+        noreplace: u32,
+    ) -> i64;
+    fn __absd_std_fs_readdir_v2(
+        path: *const u8,
+        length: usize,
+        index: u64,
+        name: *mut u8,
+        capacity: usize,
+        attr: *mut RawAttr,
+    ) -> isize;
+    fn __absd_std_fs_canonical(path: *const u8, length: usize, out: *mut u8, capacity: usize) -> isize;
+    fn __absd_std_fs_lock(handle: u64, mode: u32) -> i64;
+}
+
+const OPEN_READ: u32 = 1;
+const OPEN_WRITE: u32 = 2;
+const OPEN_CREATE: u32 = 8;
+const OPEN_CREATE_NEW: u32 = 16;
+const OPEN_TRUNCATE: u32 = 32;
+const KIND_FILE: u32 = 1;
+const KIND_DIR: u32 = 2;
+const NAME_CAPACITY: usize = 256;
+const PATH_CAPACITY: usize = 4096;
+
+fn error(result: i64) -> io::Error {
+    let (kind, detail) = match result {
+        -1 => (io::ErrorKind::PermissionDenied, "ABSD storage handle lacks the right"),
+        -2 => (io::ErrorKind::NotFound, "ABSD path not found"),
+        -5 => (io::ErrorKind::Other, "ABSD block device failed"),
+        -9 => (io::ErrorKind::InvalidInput, "ABSD file handle is not open"),
+        -11 => (io::ErrorKind::WouldBlock, "ABSD lock is held"),
+        -13 => (io::ErrorKind::PermissionDenied, "ABSD object is read-only or not opened for this"),
+        -17 => (io::ErrorKind::AlreadyExists, "ABSD path already exists"),
+        -20 => (io::ErrorKind::NotADirectory, "ABSD path component is not a directory"),
+        -21 => (io::ErrorKind::IsADirectory, "ABSD path is a directory"),
+        -22 => (io::ErrorKind::InvalidInput, "ABSD storage request is invalid"),
+        -28 => (io::ErrorKind::StorageFull, "ABSD storage is full"),
+        -30 => (io::ErrorKind::ReadOnlyFilesystem, "ABSD filesystem is mounted read-only"),
+        -39 => (io::ErrorKind::DirectoryNotEmpty, "ABSD directory is not empty"),
+        -74 => (io::ErrorKind::InvalidData, "ABSD filesystem refused corrupt metadata"),
+        -95 => (io::ErrorKind::Unsupported, "ABSD storage does not support this"),
+        -116 => (io::ErrorKind::Other, "ABSD filesystem stopped after a device failure"),
+        _ => (io::ErrorKind::Other, "ABSD storage hook failed"),
+    };
+    io::Error::new(kind, detail)
+}
+
+fn checked(result: i64) -> io::Result<u64> {
+    if result < 0 { Err(error(result)) } else { Ok(result as u64) }
+}
+
+fn bytes(path: &Path) -> &[u8] {
+    path.as_os_str().as_encoded_bytes()
+}
+
+pub struct File {
+    handle: u64,
+    append: bool,
+    position: AtomicU64,
+}
+
+#[derive(Clone, Debug)]
+pub struct FileAttr {
+    raw: RawAttrCopy,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct RawAttrCopy {
+    directory: bool,
+    readonly: bool,
+    size: u64,
+    filesystem: u64,
+    serial: u64,
+    links: u64,
+    mtime: u64,
+}
+
+/// Exactly two kinds exist (file 1, directory 2). Any other kind word is
+/// refused as the runtime refuses it (-5), never read as a file or a
+/// directory: no closed-world assumption about what the runtime passes.
+impl TryFrom<RawAttr> for FileAttr {
+    type Error = io::Error;
+
+    fn try_from(raw: RawAttr) -> io::Result<Self> {
+        let directory = match raw.kind {
+            KIND_FILE => false,
+            KIND_DIR => true,
+            _ => return Err(error(-5)),
+        };
+        Ok(FileAttr {
+            raw: RawAttrCopy {
+                directory,
+                readonly: raw.readonly != 0,
+                size: raw.size,
+                filesystem: raw.filesystem,
+                serial: raw.serial,
+                links: raw.links,
+                mtime: raw.mtime,
+            },
+        })
+    }
+}
+
+/// A listing entry's attributes: `None` (unknown) for any kind other than
+/// file or directory, so one such entry neither converts nor makes the
+/// directory unreadable.
+fn entry_attr(raw: RawAttr) -> Option<FileAttr> {
+    FileAttr::try_from(raw).ok()
+}
+
+pub struct ReadDir {
+    root: PathBuf,
+    entries: crate::vec::IntoIter<(OsString, Option<FileAttr>)>,
+}
+
+/// `attr` is `None` for an entry whose kind is unknown (SPEC A21: the
+/// runtime marks it, std represents it as unknown and never as a file or a
+/// directory).
+pub struct DirEntry {
+    root: PathBuf,
+    name: OsString,
+    attr: Option<FileAttr>,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FilePermissions {
+    readonly: bool,
+}
+
