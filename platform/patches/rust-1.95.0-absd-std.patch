@@ -0,0 +1,37 @@
+//! The kernel handles of a child's piped standard streams.
+//!
+//! A single-threaded program that multiplexes several children (a server
+//! bridging each to a connection) needs to wait on a pipe with a bound; the
+//! kernel's `transfer` does that on the handle. The handle stays owned by
+//! the `ChildStdin`/`ChildStdout`/`ChildStderr` and is closed with it.
+
+#![unstable(feature = "absd_fs_ext", issue = "none")]
+
+use crate::process::{ChildStderr, ChildStdin, ChildStdout};
+use crate::sys::AsInner;
+
+/// A kernel handle number.
+pub type RawHandle = u64;
+
+/// Borrows the kernel handle of a pipe end.
+pub trait AsRawHandle {
+    fn as_raw_handle(&self) -> RawHandle;
+}
+
+impl AsRawHandle for ChildStdin {
+    fn as_raw_handle(&self) -> RawHandle {
+        self.as_inner().handle()
+    }
+}
+
+impl AsRawHandle for ChildStdout {
+    fn as_raw_handle(&self) -> RawHandle {
+        self.as_inner().handle()
+    }
+}
+
+impl AsRawHandle for ChildStderr {
+    fn as_raw_handle(&self) -> RawHandle {
+        self.as_inner().handle()
+    }
+}
