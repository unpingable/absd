+//! ABSD: the working directory lives in the runtime (process memory, set
+//! from the startup record and by `chdir`); the kernel has none. The PID is
+//! the kernel's. Everything else is upstream's unsupported implementation.
+
+use super::unsupported;
+use crate::ffi::{OsStr, OsString};
+use crate::marker::PhantomData;
+use crate::path::{self, PathBuf};
+use crate::{fmt, io};
+
+unsafe extern "C" {
+    fn __absd_std_getcwd(out: *mut u8, capacity: usize) -> isize;
+    fn __absd_std_chdir(path: *const u8, length: usize) -> i64;
+    fn __absd_std_getpid() -> u32;
+}
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    // The runtime bounds a working directory to 1024 bytes.
+    let mut bytes = [0u8; 1024];
+    let length = unsafe { __absd_std_getcwd(bytes.as_mut_ptr(), bytes.len()) };
+    if length < 0 {
+        return Err(io::const_error!(io::ErrorKind::Other, "working directory unavailable"));
+    }
+    let path = crate::str::from_utf8(&bytes[..length as usize])
+        .map_err(|_| io::const_error!(io::ErrorKind::InvalidData, "working directory is not UTF-8"))?;
+    Ok(PathBuf::from(path))
+}
+
+pub fn chdir(path: &path::Path) -> io::Result<()> {
+    let bytes = path.as_os_str().as_encoded_bytes();
+    match unsafe { __absd_std_chdir(bytes.as_ptr(), bytes.len()) } {
+        0 => Ok(()),
+        -2 => Err(io::const_error!(io::ErrorKind::NotFound, "no such directory")),
+        -20 => Err(io::const_error!(io::ErrorKind::NotADirectory, "not a directory")),
+        -22 => Err(io::const_error!(io::ErrorKind::InvalidInput, "invalid working directory")),
+        _ => Err(io::const_error!(io::ErrorKind::Other, "cannot change working directory")),
+    }
+}
+
+pub struct SplitPaths<'a>(!, PhantomData<&'a ()>);
+
+pub fn split_paths(_unparsed: &OsStr) -> SplitPaths<'_> {
+    panic!("unsupported")
+}
+
+impl<'a> Iterator for SplitPaths<'a> {
+    type Item = PathBuf;
+    fn next(&mut self) -> Option<PathBuf> {
+        self.0
+    }
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+pub fn join_paths<I, T>(_paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    Err(JoinPathsError)
+}
