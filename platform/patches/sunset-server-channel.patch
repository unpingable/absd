+    /// Sends `SSH_MSG_CHANNEL_EOF` once. No channel data may follow it.
+    pub(crate) fn send_eof(&mut self, num: ChanNum, s: &mut TrafSend) -> Result<()> {
+        let ch = self.get_mut(num)?;
+        if ch.sent_eof || ch.sent_close {
+            return Ok(());
+        }
+        s.send(packets::ChannelEof { num: ch.send_num()? })?;
+        ch.sent_eof = true;
+        Ok(())
+    }
+
+    /// Sends an `exit-status` request on a session channel.
+    ///
+    /// Fails with a recoverable `BusySend` while output is congested.
+    pub(crate) fn send_exit_status(
+        &self,
+        num: ChanNum,
+        status: u32,
+        s: &mut TrafSend,
+    ) -> Result<()> {
+        let ch = self.get(num)?;
+        if !matches!(ch.ty, ChanType::Session) {
+            return error::BadChannelData.fail();
+        }
+        if ch.sent_close {
+            return error::ChannelEOF.fail();
+        }
+        s.send(ChannelRequest {
+            num: ch.send_num()?,
+            want_reply: false,
+            req: ChannelReqType::ExitStatus(packets::ExitStatus { status }),
+        })
+    }
+
+    /// Sends `SSH_MSG_CHANNEL_CLOSE` once.
+    pub(crate) fn send_close(&mut self, num: ChanNum, s: &mut TrafSend) -> Result<()> {
+        let ch = self.get_mut(num)?;
+        if ch.sent_close {
+            return Ok(());
+        }
+        s.send(packets::ChannelClose { num: ch.send_num()? })?;
+        ch.sent_close = true;
+        Ok(())
+    }
