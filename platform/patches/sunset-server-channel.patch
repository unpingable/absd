+    /// Sends channel EOF: this side will send no more data on `chan`.
+    ///
+    /// Sent once; later calls do nothing.
+    pub fn send_eof(&mut self, chan: &ChanHandle) -> Result<()> {
+        let mut s = self.traf_out.sender(&mut self.keys);
+        self.conn.channels.send_eof(chan.0, &mut s)?;
+        self.wake();
+        Ok(())
+    }
+
+    /// Sends an `exit-status` request for a session channel.
+    ///
+    /// Returns a `BusySend` error when output is congested; call again
+    /// after output has been consumed.
+    pub fn send_exit_status(&mut self, chan: &ChanHandle, status: u32) -> Result<()> {
+        let mut s = self.traf_out.sender(&mut self.keys);
+        self.conn.channels.send_exit_status(chan.0, status, &mut s)?;
+        self.wake();
+        Ok(())
+    }
+
+    /// Sends channel close. Sent once; later calls do nothing.
+    ///
+    /// The application still calls `channel_done()` when it has finished
+    /// with the channel.
+    pub fn close_channel(&mut self, chan: &ChanHandle) -> Result<()> {
+        let mut s = self.traf_out.sender(&mut self.keys);
+        self.conn.channels.send_close(chan.0, &mut s)?;
+        self.wake();
+        Ok(())
+    }
