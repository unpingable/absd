@@ -1632,6 +1642,7 @@
 		usage();
 
 	if (!setjmp(savesp)) {
+#ifndef ABSD_NO_SIGNALS
 		sigaction(SIGINT,
 		          &(struct sigaction) {.sa_handler = sigintr},
 		          NULL);
@@ -1641,6 +1652,12 @@
 		sigaction(SIGQUIT,
 		          &(struct sigaction) {.sa_handler = SIG_IGN},
 		          NULL);
+#endif
+		/* ABSD (userland/patches/ed-absd.patch): with ABSD_NO_SIGNALS no
+		   handler is installed; no signal is ever delivered (CPA-004).
+		   ^C in an SSH session ends the pipeline, and with it ed: the
+		   buffer is lost unless written, and the scratch file stays
+		   behind in its directory. */
 		init(*argv);
 	}
 	edit();
