+static void *alloc(size_t n) {
+ void *p = malloc(n);
+ if (!p) eprintf("out of memory\n");
+ return p;
+}
+static void checked_close(int fd) {
+ if (close(fd)) eprintf("close:");
+}
+static size_t eread(int fd, void *buf, size_t n) {
+ size_t at = 0;
+ while (at < n) {
+  ssize_t got = read(fd, (char *)buf + at, n-at);
+  if (got < 0) { if (errno == EINTR) continue; eprintf("read:"); }
+  if (!got) break;
+  at += (size_t)got;
+ }
+ return at;
+}
+static void ewrite(int fd, const void *buf, size_t n) {
+ size_t at = 0;
+ while (at < n) {
+  ssize_t got = write(fd, (const char *)buf+at, n-at);
+  if (got < 0) { if (errno == EINTR) continue; eprintf("write:"); }
+  if (!got) eprintf("zero-length write\n");
+  at += (size_t)got;
+ }
+}
+static void record(void *b) {
+ if (eread(tarfd, b, BLKSIZ) != BLKSIZ) eprintf("truncated archive record\n");
+}
+static int zero(const unsigned char *b) {
+ size_t i;
+ for (i=0; i<BLKSIZ; i++) if (b[i]) return 0;
+ return 1;
+}
+static uint64_t octal(const char *p, size_t n) {
+ size_t i=0, digits=0; uint64_t v=0;
+ while (i<n && p[i]==' ') i++;
+ while (i<n && p[i]>='0' && p[i]<='7') {
+  if (v > (UINT64_MAX-(unsigned)(p[i]-'0'))/8) eprintf("numeric overflow\n");
+  v=v*8+(unsigned)(p[i++]-'0'); digits++;
+ }
+ if (!digits || i==n) eprintf("invalid unterminated octal field\n");
+ for (;i<n;i++) if (p[i] && p[i]!=' ') eprintf("invalid octal field\n");
+ return v;
+}
+static void putoctal(char *p, size_t n, uint64_t v) {
+ size_t i=n-1;
+ p[i]=0;
+ while (i) { p[--i]=(char)('0'+(v&7)); v>>=3; }
+ if (v) eprintf("number outside ustar field\n");
+}
+static unsigned checksum(const struct header *h) {
+ const unsigned char *p=(const unsigned char *)h; unsigned v=0; size_t i;
+ for (i=0;i<BLKSIZ;i++) v += i>=148 && i<156 ? ' ' : p[i];
+ return v;
+}
+/* Normalize benign ./ and trailing separators, refuse parent/absolute paths.
+ * Never follows a symlink. The caller must keep pathname bindings stable. */
+static void path_name(const char *in, char out[PATHLEN+1]) {
+ size_t at=0;
+ if (!*in || *in=='/') eprintf("invalid absolute/empty member path\n");
+ while (*in) {
+  const char *end=strchr(in,'/'); size_t n=end ? (size_t)(end-in) : strlen(in);
+  if (n==2 && in[0]=='.' && in[1]=='.') eprintf("parent member path refused\n");
+  if (n && !(n==1 && *in=='.')) {
+   if (at+n+(at!=0)>PATHLEN) eprintf("member path exceeds ustar range\n");
+   if (at) out[at++]='/';
+   memcpy(out+at,in,n); at+=n;
+  }
+  if (!end) break;
+  in=end+1;
+ }
+ if (!at) out[at++]='.';
+ out[at]=0;
+}
+static void header_name(struct header *h, const char *path) {
+ size_t n=strlen(path), i;
+ if (n<=sizeof(h->name)) { memcpy(h->name,path,n); return; }
+ for (i=n;i;i--) if (path[i-1]=='/' && i-1<=sizeof(h->prefix) && n-i<=sizeof(h->name)) {
+  memcpy(h->prefix,path,i-1); memcpy(h->name,path+i,n-i); return;
+ }
+ eprintf("member path has no ustar prefix split\n");
+}
+static void decode_name(const struct header *h, char out[PATHLEN+1]) {
+ char raw[PATHLEN+1]; size_t p=strnlen(h->prefix,sizeof(h->prefix)), n=strnlen(h->name,sizeof(h->name)), at=0;
+ if (!n) eprintf("empty member name\n");
+ if (p) { memcpy(raw,h->prefix,p); at=p; raw[at++]='/'; }
+ memcpy(raw+at,h->name,n); raw[at+n]=0; path_name(raw,out);
+}
+/* Ancestors and destination validated before any current-member mutation. */
+static void check_path(const char *name, int directory) {
+ char p[PATHLEN+1]; struct stat st; size_t i,n=strlen(name);
+ memcpy(p,name,n+1);
+ for (i=0;i<=n;i++) if (!p[i] || p[i]=='/') {
+  char save=p[i]; p[i]=0;
+  if (lstat(p,&st)==0) {
+   if (S_ISLNK(st.st_mode) || ((save || directory) ? !S_ISDIR(st.st_mode) : !S_ISREG(st.st_mode)))
+    eprintf("path kind conflict: %s\n",p);
+   if (!save && archive_identity && st.st_dev==tardev && st.st_ino==tarinode) eprintf("archive would overwrite itself: %s\n",p);
+   if (!save && !directory && !(st.st_mode&S_IWUSR)) eprintf("readonly destination: %s\n",p);
+  } else if (errno!=ENOENT) eprintf("stat %s:",p);
+  p[i]=save;
+ }
+}
+static void parents(const char *name, int directory) {
+ char p[PATHLEN+1]; size_t i,n=strlen(name); struct stat st;
+ memcpy(p,name,n+1);
+ for (i=0;i<=n;i++) if (p[i]=='/' || (!p[i] && directory)) {
+  char save=p[i]; p[i]=0;
+  if (lstat(p,&st)<0) {
+   if (errno!=ENOENT || mkdir(p,0755)) eprintf("mkdir %s:",p);
+  } else if (!S_ISDIR(st.st_mode)) eprintf("directory conflict: %s\n",p);
+  p[i]=save;
+ }
+}
+static void payload(uint64_t size, int out) {
+ unsigned char b[BLKSIZ];
+ while (size) {
+  size_t n=size<BLKSIZ ? (size_t)size : BLKSIZ;
+  record(b); if (out>=0) ewrite(out,b,n); size-=n;
+ }
+}
+static void unarchive(const char *name, uint64_t size, uint64_t mode, int directory) {
+ int fd;
+ check_path(name,directory);
+ parents(name,directory);
+ if (directory) return;
+ fd=open(name,O_WRONLY|O_CREAT|O_TRUNC,0644);
+ if (fd<0) eprintf("open %s:",name);
+ payload(size,fd); checked_close(fd);
+ if (chmod(name,(mode&S_IWUSR)?0644:0444)) eprintf("chmod %s:",name);
+}
+static void archive(const char *path) {
+ struct header h; struct stat st, after; uint64_t left; unsigned char b[BLKSIZ]; int fd=-1;
+ if (lstat(path,&st)) eprintf("stat %s:",path);
+ if (archive_identity && st.st_ino==tarinode && st.st_dev==tardev) return;
+ if (!S_ISREG(st.st_mode) && !S_ISDIR(st.st_mode)) eprintf("unsupported source kind: %s\n",path);
+ memset(&h,0,sizeof(h)); header_name(&h,path);
+ if (st.st_size<0 || st.st_mtime<0) eprintf("negative source metadata\n");
+ putoctal(h.mode,sizeof(h.mode),(uint64_t)(st.st_mode&07777));
+ putoctal(h.uid,sizeof(h.uid),(uint64_t)st.st_uid); putoctal(h.gid,sizeof(h.gid),(uint64_t)st.st_gid);
+ left=S_ISREG(st.st_mode)?(uint64_t)st.st_size:0;
+ putoctal(h.size,sizeof(h.size),left); putoctal(h.mtime,sizeof(h.mtime),(uint64_t)st.st_mtime);
+ putoctal(h.major,sizeof(h.major),0); putoctal(h.minor,sizeof(h.minor),0);
+ memcpy(h.magic,"ustar",6); memcpy(h.version,"00",2); h.type=S_ISDIR(st.st_mode)?'5':'0';
+ putoctal(h.chksum,sizeof(h.chksum),checksum(&h));
+ if (S_ISREG(st.st_mode)) {
+  fd=open(path,O_RDONLY); if (fd<0) eprintf("open %s:",path);
+  if (fstat(fd,&after) || after.st_size!=st.st_size || after.st_dev!=st.st_dev || after.st_ino!=st.st_ino)
+   eprintf("source changed before read: %s\n",path);
+ }
+ ewrite(tarfd,&h,BLKSIZ);
+ while (left) {
+  size_t n=left<BLKSIZ?(size_t)left:BLKSIZ;
+  memset(b,0,sizeof(b)); if (eread(fd,b,n)!=n) eprintf("source shortened: %s\n",path);
+  ewrite(tarfd,b,BLKSIZ); left-=n;
+ }
+ if (fd>=0) {
+  if (eread(fd,b,1) || fstat(fd,&after) || after.st_size!=st.st_size) eprintf("source size changed: %s\n",path);
+  checked_close(fd);
+ }
+ if (vflag && fprintf(stderr,"%s\n",path)<0) eprintf("verbose output:");
+}
+static void walk(const char *path) {
+ struct stat st; DIR *dir; struct dirent *entry;
+ archive(path);
+ if (lstat(path,&st)) eprintf("stat %s:",path);
+ if (!S_ISDIR(st.st_mode)) return;
+ dir=opendir(path); if (!dir) eprintf("opendir %s:",path);
+ for (;;) {
+  char child[PATHLEN+1]; size_t a=!strcmp(path,".")?0:strlen(path), b;
+  errno=0; entry=readdir(dir);
+  if (!entry) { if (errno) eprintf("readdir %s:",path); break; }
+  if (!strcmp(entry->d_name,".") || !strcmp(entry->d_name,"..")) continue;
+  b=strlen(entry->d_name);
+  if (a+(a!=0)+b>PATHLEN) eprintf("source path exceeds ustar range\n");
+  memcpy(child,path,a); if (a) child[a++]='/'; memcpy(child+a,entry->d_name,b+1); walk(child);
+ }
+ if (closedir(dir)) eprintf("closedir:");
+}
+static void xt(int argc, char **argv, int mode) {
+ struct header h; char name[PATHLEN+1]; unsigned char *seen=alloc(argc?(size_t)argc:1); int i;
+ memset(seen,0,argc?(size_t)argc:1);
+ for (;;) {
+  uint64_t size, perm; int selected=!argc, directory;
+  record(&h);
+  if (zero((unsigned char *)&h)) { record(&h); if (!zero((unsigned char *)&h)) eprintf("missing second end record\n"); break; }
+  if (memcmp(h.magic,"ustar",6) || memcmp(h.version,"00",2)) eprintf("unsupported archive format\n");
+  if (octal(h.chksum,sizeof(h.chksum))!=checksum(&h)) eprintf("incorrect header checksum\n");
+  perm=octal(h.mode,sizeof(h.mode)); if (perm>07777) eprintf("invalid mode\n");
+  (void)octal(h.uid,sizeof(h.uid)); (void)octal(h.gid,sizeof(h.gid));
+  (void)octal(h.mtime,sizeof(h.mtime)); size=octal(h.size,sizeof(h.size));
+  directory=h.type=='5';
+  if (!directory && h.type!='0' && h.type!='\0') eprintf("unsupported member type\n");
+  if (h.linkname[0]) eprintf("unexpected link target\n");
+  decode_name(&h,name);
+  if (!strcmp(name,".") && !directory) eprintf("non-directory dot member\n");
+  if (directory) size=0; /* ustar directory size is ignored; no data records */
+  for (i=0;i<argc;i++) {
+   size_t n=strlen(argv[i]);
+   if (!strcmp(argv[i],".") || !strcmp(name,argv[i]) || (!strncmp(name,argv[i],n) && name[n]=='/')) selected=seen[i]=1;
+  }
+  if (!selected) payload(size,-1);
+  else if (mode=='t') { if (puts(name)<0) eprintf("listing output:"); payload(size,-1); }
+  else { unarchive(name,size,perm,directory); if (vflag && fprintf(stderr,"%s\n",name)<0) eprintf("verbose output:"); }
+ }
+ for (i=0;i<argc;i++) if (!seen[i]) eprintf("selected member absent: %s\n",argv[i]);
+ free(seen);
+}
+static void usage(void) {
+ eprintf("usage: tar [-C dir] [-v] [-m] -c|-t|-x [-f archive] [file ...]\n");
+}
+int main(int argc, char **argv) {
+ char *file=NULL,*dir=".",mode=0; int own=0,i; struct stat st; char **names;
+ ARGBEGIN {
+ case 'c': case 't': case 'x': if (mode) usage(); mode=ARGC(); break;
+ case 'C': dir=EARGF(usage()); break;
+ case 'f': file=EARGF(usage()); break;
+ case 'v': vflag=1; break;
+ case 'm': break; /* Native extraction never restores Unix timestamps. */
+ default: usage();
+ } ARGEND
+ if (!mode || (mode=='c' && !argc)) usage();
+ names=alloc((argc?(size_t)argc:1)*sizeof(*names));
+ for (i=0;i<argc;i++) { names[i]=alloc(PATHLEN+1); path_name(argv[i],names[i]); }
+ tarfd=mode=='c'?1:0;
+ if (file && strcmp(file,"-")) {
+  tarfd=open(file,mode=='c'?O_WRONLY|O_CREAT|O_TRUNC:O_RDONLY,0644);
+  if (tarfd<0) eprintf("open archive %s:",file);
+  own=1;
+ }
+ if (!fstat(tarfd,&st)) { archive_identity=1; tarinode=st.st_ino; tardev=st.st_dev; }
+ if (chdir(dir)) eprintf("chdir %s:",dir);
+ if (mode=='c') { unsigned char end[BLKSIZ*2]={0}; for (i=0;i<argc;i++) walk(names[i]); ewrite(tarfd,end,sizeof(end)); }
+ else xt(argc,names,mode);
+ if (fflush(stdout) || ferror(stdout) || fflush(stderr) || ferror(stderr)) eprintf("output error\n");
+ if (own) checked_close(tarfd);
+ for (i=0;i<argc;i++) free(names[i]);
+ free(names);
+ return 0;
+}
