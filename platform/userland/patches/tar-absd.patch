-		if ((size = strtol(h->size, &p, 8)) < 0 || *p != '\0')
-			eprintf("strtol %s: invalid number\n", h->size);
-
-		if (argc) {
-			/* only extract the given files */
-			for (i = 0; i < argc; i++)
