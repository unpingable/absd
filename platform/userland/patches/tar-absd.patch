-		while ((dirtime = popdirtime())) {
-			times[0].tv_sec = times[1].tv_sec = dirtime->mtime;
-			times[0].tv_nsec = times[1].tv_nsec = 0;
-			if (utimensat(AT_FDCWD, dirtime->name, times, 0) < 0)
-				eprintf("utimensat %s:", fname);
-			free(dirtime->name);
-		}
