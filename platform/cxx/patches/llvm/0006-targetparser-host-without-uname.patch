   if (Triple(LLVM_HOST_TRIPLE).getOS() == Triple::AIX) {
     Triple TT(TargetTripleString);
     if (TT.getOS() == Triple::AIX && !TT.getOSMajorVersion()) {
@@ -69,6 +78,7 @@
       }
     }
   }
+#endif
   return TargetTripleString;
 }
 
