+#if defined(LLVM_ABSD_KIT)
+// The kit has no mmap (C-INTERFACE.md section 3). A read-only or private
+// region is the same bytes read into the heap: a private mapping's writes
+// never reach the file, so a heap copy is that mapping exactly; bytes past
+// the end of the file read as zero, as in a mapping. A shared (readwrite)
+// region, whose writes must reach the file, is refused: FileOutputBuffer
+// writes through memory and a plain write instead (cxx/patches/llvm/0005).
+// The descriptor's position is left where it was.
+std::error_code mapped_file_region::init(int FD, uint64_t Offset, mapmode Mode) {
+  assert(Size != 0);
+  if (Mode == readwrite)
+    return make_error_code(errc::function_not_supported);
+  const size_t Page = Process::getPageSizeEstimate();
+  void *Buf = aligned_alloc(Page, (Size + Page - 1) / Page * Page);
+  if (!Buf)
+    return make_error_code(errc::not_enough_memory);
+  memset(Buf, 0, Size);
+  off_t Saved = ::lseek(FD, 0, SEEK_CUR);
+  if (Saved == -1 || ::lseek(FD, Offset, SEEK_SET) == -1) {
+    int Error = errno;
+    free(Buf);
+    return std::error_code(Error, std::generic_category());
+  }
+  size_t Done = 0;
+  while (Done < Size) {
+    ssize_t N = ::read(FD, static_cast<char *>(Buf) + Done, Size - Done);
+    if (N == -1) {
+      int Error = errno;
+      ::lseek(FD, Saved, SEEK_SET);
+      free(Buf);
+      return std::error_code(Error, std::generic_category());
+    }
+    if (N == 0)
+      break;
+    Done += N;
+  }
+  ::lseek(FD, Saved, SEEK_SET);
+  Mapping = Buf;
+  return std::error_code();
+}
+
+mapped_file_region::mapped_file_region(int fd, mapmode mode, size_t length,
+                                       uint64_t offset, std::error_code &ec)
+    : Size(length), Mode(mode) {
+  ec = init(fd, offset, mode);
+  if (ec)
+    copyFrom(mapped_file_region());
+}
+
+void mapped_file_region::unmapImpl() {
+  if (Mapping)
+    free(Mapping);
+}
+
+void mapped_file_region::dontNeedImpl() {}
