+#if defined(LLVM_ABSD_O0_ONLY)
+// An -O0-only image (scripts/build-llvm-kit.sh, step alternatives): every
+// optimizing pipeline is left out, so the optimization passes they name are
+// unreachable and --gc-sections drops them. Asking for one is a fatal
+// error naming it; -O0 is unchanged (the default and pre-link builders
+// still hand O0 to buildO0DefaultPipeline, below, as upstream does).
+[[noreturn]] static void absdO0Only(const char *What) {
+  report_fatal_error(Twine(What) +
+                         ": this image carries the -O0 pipeline only "
+                         "(LLVM_ABSD_O0_ONLY)",
+                     /*gen_crash_diag=*/false);
+}
+
+FunctionPassManager
+PassBuilder::buildO1FunctionSimplificationPipeline(OptimizationLevel Level,
+                                                   ThinOrFullLTOPhase Phase) {
+  absdO0Only("buildO1FunctionSimplificationPipeline");
+}
+
+FunctionPassManager
+PassBuilder::buildFunctionSimplificationPipeline(OptimizationLevel Level,
+                                                 ThinOrFullLTOPhase Phase) {
+  absdO0Only("buildFunctionSimplificationPipeline");
+}
+
+ModuleInlinerWrapperPass
+PassBuilder::buildInlinerPipeline(OptimizationLevel Level,
+                                  ThinOrFullLTOPhase Phase) {
+  absdO0Only("buildInlinerPipeline");
+}
+
+ModulePassManager
+PassBuilder::buildModuleInlinerPipeline(OptimizationLevel Level,
